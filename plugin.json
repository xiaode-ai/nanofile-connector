{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "nanofile",
  "displayName": "NanoFile Native FS & Search",
  "version": "1.0.8",
  "description": "High-performance native Windows filesystem management, lightning search, tags, and favorites plugin for AI agents.",
  "logo": "assets/logo.png",
  "icon": "https://raw.githubusercontent.com/xiaode-ai/nanofile-connector/main/assets/logo.png",
  "suggestedPrompts": [
    "Search for files matching *.pdf in Downloads using NanoFile",
    "Find all files tagged with 'Project' and inspect their metadata",
    "List system drives and get folder size breakdown"
  ],
  "author": {
    "name": "NanoFile Team",
    "url": "https://apps.microsoft.com/detail/9pgwd50gwcjw"
  },
  "homepage": "https://apps.microsoft.com/detail/9pgwd50gwcjw",
  "repository": "https://github.com/xiaode-ai/nanofile-connector",
  "license": "MIT",
  "skills": [
    "skills/items",
    "skills/files",
    "skills/folders",
    "skills/tags",
    "skills/metadata",
    "skills/apps",
    "skills/favorites"
  ],
  "mcpServers": {
    "nanofile": {
      "command": "nanofile.exe",
      "args": ["--mcp"]
    }
  }
}
