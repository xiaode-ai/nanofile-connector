{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "nanofile-agent-plugin",
  "version": "1.0.8",
  "displayName": "NanoFile Agent Plugin",
  "description": "Native Windows filesystem management, lightning search, and tags plugin for AI agents.",
  "author": "NanoFile Team",
  "license": "MIT",
  "homepage": "https://apps.microsoft.com/detail/9pgwd50gwcjw",
  "repository": "https://github.com/xiaode-ai/nanofile-connector",
  "icon": "https://raw.githubusercontent.com/xiaode-ai/nanofile-connector/main/assets/logo.png",
  "entrypoint": {
    "type": "mcp_stdio",
    "command": "nanofile.exe",
    "args": [
      "--mcp"
    ],
    "schema": "../mcp/schema.json"
  },
  "runtimeRequirements": {
    "os": "windows",
    "minWindowsVersion": "10.0.19041",
    "app": "NanoFile Desktop (Microsoft Store)"
  },
  "categories": [
    {
      "id": "items",
      "name": "Item Management",
      "tools": 3,
      "skill": "../skills/items/SKILL.md"
    },
    {
      "id": "files",
      "name": "File Operations",
      "tools": 5,
      "skill": "../skills/files/SKILL.md"
    },
    {
      "id": "folders",
      "name": "Folder Operations",
      "tools": 5,
      "skill": "../skills/folders/SKILL.md"
    },
    {
      "id": "tags",
      "name": "Tag Management",
      "tools": 6,
      "skill": "../skills/tags/SKILL.md"
    },
    {
      "id": "metadata",
      "name": "Metadata & Recursive Size",
      "tools": 2,
      "skill": "../skills/metadata/SKILL.md"
    },
    {
      "id": "apps",
      "name": "Application Management",
      "tools": 3,
      "skill": "../skills/apps/SKILL.md"
    },
    {
      "id": "favorites",
      "name": "Favorites & Quick Access",
      "tools": 3,
      "skill": "../skills/favorites/SKILL.md"
    }
  ],
  "toolCount": 27,
  "pluginIntegrations": {
    "smithery_mcp": "../smithery.yaml",
    "antigravity_claude": "../plugin.json",
    "dify_plugin": "./dify/manifest.yaml",
    "cursor_rules": "./cursor/.cursorrules",
    "langchain_toolkit": "./langchain/toolkit.json"
  }
}
